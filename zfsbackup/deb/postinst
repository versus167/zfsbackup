#!/bin/sh
set -e

if [ "$1" = "configure" ] && [ ! -e /etc/zfsbackup/zfsbackup_receiver.conf ]; then
    echo "zfsbackup: /etc/zfsbackup/zfsbackup_receiver.conf fehlt - ohne diese Datei lehnt zfsbackup_receiver jeden Aufruf ab." >&2
    echo "           Nur nötig, wenn dieser Rechner Backups per ssh empfängt. Vorlage daneben:" >&2
    echo "           /etc/zfsbackup/zfsbackup_receiver.conf.example" >&2
fi

exit 0
